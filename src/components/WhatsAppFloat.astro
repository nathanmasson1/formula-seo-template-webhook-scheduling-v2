---
import { readData } from '../lib/readData';
import { socialLinkAttrs } from '../lib/socialLinks';

const backlinks = readData('backlinks.json') || {};
const site = readData('siteConfig.json') || {};
const href =
  backlinks.hero?.primaryCta?.href ||
  backlinks.cta?.primaryCta?.href ||
  site.contact?.whatsapp ||
  site.contact?.phone ||
  '';

const whatsappHref = href.startsWith('http')
  ? href
  : href
    ? `https://wa.me/${href.replace(/\D/g, '')}`
    : '';
---

{whatsappHref && (
  <a class="whatsapp-float" href={whatsappHref} {...socialLinkAttrs(whatsappHref, 'Falar no WhatsApp')}>
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path d="M16.04 3.2c-7.02 0-12.72 5.7-12.72 12.72 0 2.24.59 4.42 1.7 6.35L3.2 28.8l6.68-1.75a12.67 12.67 0 0 0 6.16 1.57c7.02 0 12.72-5.7 12.72-12.72S23.06 3.2 16.04 3.2Zm0 23.28c-1.93 0-3.82-.52-5.47-1.5l-.39-.23-3.96 1.04 1.06-3.86-.25-.4a10.5 10.5 0 0 1-1.58-5.61c0-5.84 4.75-10.59 10.59-10.59s10.59 4.75 10.59 10.59-4.75 10.56-10.59 10.56Zm5.8-7.93c-.32-.16-1.88-.93-2.17-1.03-.29-.11-.5-.16-.71.16-.21.32-.82 1.03-1 1.24-.18.21-.37.24-.69.08-.32-.16-1.34-.49-2.55-1.57-.94-.84-1.58-1.88-1.77-2.2-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.55.16-.18.21-.32.32-.53.11-.21.05-.4-.03-.55-.08-.16-.71-1.72-.98-2.35-.26-.62-.52-.53-.71-.54h-.61c-.21 0-.55.08-.84.4-.29.32-1.11 1.08-1.11 2.64s1.14 3.07 1.3 3.28c.16.21 2.25 3.43 5.44 4.81.76.33 1.36.53 1.82.68.76.24 1.46.21 2.01.13.61-.09 1.88-.77 2.14-1.51.26-.74.26-1.38.18-1.51-.08-.13-.29-.21-.61-.37Z" fill="currentColor" />
    </svg>
  </a>
)}

<style>
  .whatsapp-float {
    position: fixed;
    right: 28px;
    bottom: 28px;
    z-index: 90;
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #27d466;
    color: #fff;
    box-shadow: 0 12px 30px rgba(39, 212, 102, .35);
    transition:
      transform 220ms var(--ease-out-expo),
      box-shadow 220ms var(--ease-out-expo),
      background 220ms var(--ease-out-expo);
  }

  .whatsapp-float:hover {
    color: #fff;
    transform: translateY(-3px);
    background: #22c85d;
    box-shadow: 0 16px 36px rgba(39, 212, 102, .42);
  }

  .whatsapp-float svg {
    width: 34px;
    height: 34px;
    display: block;
  }

  @media (max-width: 768px) {
    .whatsapp-float {
      right: 18px;
      bottom: 18px;
      width: 54px;
      height: 54px;
    }

    .whatsapp-float svg {
      width: 31px;
      height: 31px;
    }
  }
</style>
