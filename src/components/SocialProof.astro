---
interface Props { data?: any; }
const d = Astro.props.data || {};
const stats = d.stats || [
  { number: '4.9', suffix: '/5', label: 'Avaliação Média', detail: '+200 reviews verificados' },
  { number: '50k', suffix: '+', label: 'Leitores Mensais', detail: 'Crescendo todo mês' },
  { number: '500', suffix: '+', label: 'Produtos Avaliados', detail: 'Reviews detalhados' },
  { number: 'R$2M', suffix: '+', label: 'Economia Gerada', detail: 'Para nossos leitores' },
];
const brands = (d.brands || ['Amazon', 'Hotmart', 'Mercado Livre', 'Shopee', 'Eduzz', 'Monetizze']).map((brand: any) => (
  typeof brand === 'string' ? { title: brand, description: '' } : brand
));
const brandLabel = d.brandLabel || 'Avaliamos produtos das maiores plataformas';
---

<section class="social-proof">
  <div class="container">
    <div class="proof-stats stagger-children animate-on-scroll">
      {stats.map((stat) => (
        <div class="proof-stat">
          <div class="proof-stat-number">
            {stat.number}<span class="proof-stat-suffix">{stat.suffix}</span>
          </div>
          <div class="proof-stat-label">{stat.label}</div>
          <div class="proof-stat-detail">{stat.detail}</div>
        </div>
      ))}
    </div>

    <div class="proof-brands animate-on-scroll">
      <div class="proof-brands-line"></div>
      <h2 class="proof-brands-label">{brandLabel}</h2>
      <div class="proof-brands-list">
        {brands.map((brand, index) => (
          <article class="proof-brand">
            <span class="proof-brand-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{brand.title}</h3>
              {brand.description && <p>{brand.description}</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .social-proof {
    padding: var(--space-3xl) 0 var(--space-4xl);
    background: var(--color-bg);
    position: relative;
  }

  .proof-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border-light);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: var(--space-4xl);
  }

  .proof-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-2xl) var(--space-lg);
    background: var(--color-bg);
    transition: background var(--transition-base);
    animation: fadeInUp 500ms var(--ease-out-expo) both;
  }

  .proof-stat:hover {
    background: var(--color-bg-warm);
  }

  .proof-stat-number {
    font-family: var(--font-heading);
    font-size: var(--fs-3xl);
    font-weight: var(--fw-extrabold);
    color: var(--color-primary);
    letter-spacing: var(--ls-tight);
    line-height: 1;
    margin-bottom: var(--space-sm);
  }

  .proof-stat-suffix {
    font-weight: var(--fw-medium);
    color: var(--color-primary-light);
  }

  .proof-stat-label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    margin-bottom: 4px;
  }

  .proof-stat-detail {
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
  }

  /* Brands */
  .proof-brands {
    text-align: center;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0;
  }

  .proof-brands-line {
    width: 76px;
    height: 4px;
    border-radius: 999px;
    background: linear-gradient(90deg, #8e24cc, #f4b63f);
    margin: 0 auto var(--space-md);
  }

  .proof-brands-label {
    max-width: 760px;
    margin: 0 auto var(--space-2xl);
    color: #261137;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.05;
    text-transform: none;
    letter-spacing: 0;
    font-weight: var(--fw-extrabold);
  }

  .proof-brands-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
    text-align: left;
  }

  .proof-brand {
    position: relative;
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: var(--space-md);
    align-items: start;
    min-height: 188px;
    padding: var(--space-xl);
    border-radius: 8px;
    border: 1px solid rgba(142, 36, 204, 0.12);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.92)),
      linear-gradient(135deg, rgba(142, 36, 204, 0.08), rgba(244, 182, 63, 0.08));
    color: var(--color-text);
    box-shadow: 0 16px 38px rgba(58, 18, 88, 0.08);
    opacity: 1;
    overflow: hidden;
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base),
      background var(--transition-base);
    letter-spacing: 0;
  }

  .proof-brand::after {
    content: "";
    position: absolute;
    inset: auto var(--space-xl) 0;
    height: 3px;
    border-radius: 999px 999px 0 0;
    background: linear-gradient(90deg, #8e24cc, #f4b63f);
    opacity: 0;
    transform: translateY(3px);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
  }

  .proof-brand-number {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background: var(--color-primary-surface);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    font-weight: var(--fw-extrabold);
  }

  .proof-brand h3 {
    display: block;
    color: #261137;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.12;
    letter-spacing: 0;
    margin-bottom: var(--space-sm);
  }

  .proof-brand p {
    display: block;
    max-width: 34ch;
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
  }

  .proof-brand:hover {
    transform: translateY(-4px);
    border-color: rgba(142, 36, 204, 0.32);
    background: #fff;
    box-shadow: 0 22px 46px rgba(58, 18, 88, 0.14);
  }

  .proof-brand:hover::after {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1024px) {
    .proof-brands-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .proof-stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .proof-brands-list {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .proof-brands {
      padding: 0;
    }

    .proof-brand {
      grid-template-columns: 42px 1fr;
      min-height: 0;
      padding: var(--space-lg);
    }

    .proof-brand p {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .proof-stats {
      grid-template-columns: 1fr 1fr;
    }

    .proof-stat {
      padding: var(--space-xl) var(--space-md);
    }
  }
</style>
