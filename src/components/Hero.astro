---
import { socialLinkAttrs } from '../lib/socialLinks';

interface Props {
  data?: any;
}


const d = Astro.props.data || {};
const title = d.title || 'Cresça no Google com estratégia, conteúdo e autoridade';
const subtitle = d.subtitle || 'Planejamos SEO, backlinks, conteúdo e otimização para marcas que precisam transformar tráfego orgânico em oportunidades reais de venda.';
const ctaPrimary = d.ctaPrimary || { text: 'Conhecer Serviços', href: '/backlinks' };
const ctaSecondary = d.ctaSecondary || { text: 'Falar com Especialista', href: '/contato' };
const heroImage = d.image || '/images/marketing-agency-hero.jpg';
const stats = d.stats || [
  { number: '120+', label: 'Sites parceiros' },
  { number: '500+', label: 'Clientes atendidos' },
  { number: '5000+', label: 'Guest posts' },
];
const cards = d.cards || [
  { icon: '01', title: 'SEO técnico', text: 'Base pronta para ranquear' },
  { icon: '02', title: 'Backlinks', text: 'Autoridade com contexto' },
  { icon: '03', title: 'Conteúdo', text: 'Busca virando conversão' },
];
---

<section class="hero">
  <div class="hero-bg">
    <div class="hero-gradient"></div>
    <div class="hero-pattern"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-content">
      <h1 class="hero-title">{title}</h1>

      <p class="hero-subtitle">{subtitle}</p>

      <div class="hero-actions">
        <a href={ctaPrimary.href} class="btn btn-primary btn-lg" {...socialLinkAttrs(ctaPrimary.href, ctaPrimary.text)}>
          {ctaPrimary.text}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href={ctaSecondary.href} class="btn btn-whatsapp" {...socialLinkAttrs(ctaSecondary.href, ctaSecondary.text)}>
          {ctaSecondary.text}
        </a>
      </div>

      <div class="hero-stats">
        {stats.map((stat: any, i: number) => (
          <>
            {i > 0 && <div class="hero-stat-divider"></div>}
            <div class="hero-stat">
              <span class="hero-stat-number">{stat.number}</span>
              <span class="hero-stat-label">{stat.label}</span>
            </div>
          </>
        ))}
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-image-frame">
        <img src={heroImage} alt="Estratégia de marketing digital e SEO" width="800" height="900" />
        <div class="hero-image-overlay">
          <span>Pipeline orgânico</span>
          <strong>Pesquisa → Conteúdo → Autoridade → Leads</strong>
        </div>
      </div>
      <div class="hero-cards">
        {cards.map((card: any) => (
          <div class="hero-card">
            <div class="hero-card-icon">{card.icon}</div>
            <div class="hero-card-text">
              <strong>{card.title}</strong>
              <span>{card.text}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: var(--navbar-height);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(135deg, rgba(52, 8, 88, 0.9), rgba(142, 36, 204, 0.74)),
      url('/images/marketing-agency-hero.jpg') center/cover;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(28, 5, 50, 0.9) 0%, rgba(91, 22, 145, 0.64) 52%, rgba(184, 45, 210, 0.36) 100%),
      linear-gradient(180deg, rgba(20, 8, 36, 0.2), rgba(20, 8, 36, 0.78));
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background-image:
      linear-gradient(var(--color-primary) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-primary) 1px, transparent 1px);
    background-size: 44px 44px;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-4xl);
    align-items: center;
    padding: var(--space-4xl) 0;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: var(--fs-hero);
    font-weight: var(--fw-extrabold);
    line-height: 1.05;
    letter-spacing: 0;
    margin-bottom: var(--space-xl);
    color: #fff;
    animation: fadeInUp 600ms var(--ease-out-expo) 100ms both;
  }

  .hero-subtitle {
    font-size: var(--fs-md);
    font-weight: var(--fw-light);
    color: rgba(255, 255, 255, 0.82);
    line-height: var(--lh-relaxed);
    margin-bottom: var(--space-2xl);
    max-width: 560px;
    animation: fadeInUp 600ms var(--ease-out-expo) 200ms both;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-4xl);
    animation: fadeInUp 600ms var(--ease-out-expo) 300ms both;
  }

  .btn-lg {
    padding: 1rem 2.5rem;
    font-size: var(--fs-sm);
  }

  .btn-whatsapp {
    color: #fff;
    background: linear-gradient(135deg, #25d366, #128c4a);
    border-color: transparent;
    padding: 1rem 1.6rem;
    box-shadow: 0 14px 30px rgba(37, 211, 102, 0.28);
  }

  .btn-whatsapp:hover {
    color: #fff;
    background: linear-gradient(135deg, #2be36f, #0f7f42);
    transform: translateY(-2px);
    box-shadow: 0 18px 36px rgba(37, 211, 102, 0.34);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    animation: fadeInUp 600ms var(--ease-out-expo) 400ms both;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero-stat-number {
    font-family: var(--font-heading);
    font-size: var(--fs-2xl);
    font-weight: var(--fw-extrabold);
    color: #f4b63f;
    letter-spacing: var(--ls-tight);
  }

  .hero-stat-label {
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
  }

  .hero-stat-divider {
    width: 1px;
    height: 36px;
    background: rgba(255, 255, 255, 0.24);
  }

  .hero-visual {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 0.82fr;
    gap: var(--space-lg);
    align-items: end;
  }

  .hero-image-frame {
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-pure);
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--color-border-light);
    animation: scaleIn 800ms var(--ease-out-expo) 300ms both;
  }

  .hero-image-frame img {
    width: 100%;
    height: 430px;
    display: block;
    object-fit: cover;
  }

  .hero-image-overlay {
    padding: var(--space-lg);
    background: var(--color-bg-dark);
    color: #fff;
  }

  .hero-image-overlay span {
    display: block;
    color: var(--color-accent-light);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--ls-widest);
    margin-bottom: var(--space-xs);
  }

  .hero-image-overlay strong {
    font-size: var(--fs-sm);
  }

  .hero-cards {
    display: grid;
    gap: var(--space-sm);
  }

  .hero-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--color-bg-pure);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border-light);
    animation: fadeInUp 600ms var(--ease-out-expo) both;
  }

  .hero-card-icon {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--color-primary-surface);
    color: var(--color-primary);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    flex: 0 0 auto;
  }

  .hero-card-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .hero-card-text strong {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .hero-card-text span {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 1100px) {
    .hero-visual {
      grid-template-columns: 1fr;
    }

    .hero-cards {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1025px) and (max-height: 820px) {
    .hero {
      min-height: calc(100vh - var(--navbar-height));
    }

    .hero-inner {
      gap: var(--space-3xl);
      padding: var(--space-xl) 0 var(--space-2xl);
    }

    .hero-title {
      font-size: clamp(3.5rem, 4.2vw, 4.25rem);
      line-height: 1;
      margin-bottom: var(--space-lg);
    }

    .hero-subtitle {
      font-size: var(--fs-base);
      line-height: 1.55;
      margin-bottom: var(--space-xl);
      max-width: 600px;
    }

    .hero-actions {
      margin-bottom: var(--space-2xl);
    }

    .hero-image-frame img {
      height: 360px;
    }

    .hero-image-overlay {
      padding: var(--space-md);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-top: var(--navbar-height);
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-3xl);
      text-align: center;
      padding: var(--space-3xl) var(--space-sm) var(--space-4xl);
    }

    .hero-subtitle {
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions {
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero-stats {
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero-visual {
      display: none;
    }
  }
</style>
