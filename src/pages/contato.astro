---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readData } from '../lib/readData';

const contato = readData('contato.json') || {};
const seo = contato.seo || {};
const hero = contato.hero || {};
const contactMethods = contato.methods || [];
const form = contato.form || {};
const faqSec = contato.faq || {};
const faqs = faqSec.items || [];
const subjects = form.subjects || [];
---

<BaseLayout
  title={seo.title || 'Contato'}
  description={seo.description || 'Fale com nossa agência de marketing digital.'}
  image={seo.image || undefined}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq: any) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  })} />

  <section class="contact-hero">
    <div class="container contact-hero-inner">
      <div>
        <span class="section-label">{hero.label || 'Contato'}</span>
        <h1>
          {hero.title || 'Vamos planejar seu'}
          <span>{hero.titleAccent || 'crescimento orgânico'}</span>
        </h1>
      </div>
      <p>{hero.subtitle}</p>
    </div>
  </section>

  <section class="contact-methods">
    <div class="container methods-grid">
      {contactMethods.map((method: any) => (
        <article>
          <div class="method-icon" set:html={method.icon} />
          <h3>{method.title}</h3>
          <strong>{method.detail}</strong>
          <p>{method.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="contact-main section">
    <div class="container contact-grid">
      <div class="contact-form-panel">
        <span class="section-label">Briefing inicial</span>
        <h2>{form.title || 'Solicite uma proposta'}</h2>
        <p>{form.subtitle}</p>

        <form class="contact-form" id="contactForm" data-success-text={form.successText || 'Solicitação enviada!'}>
          <div class="form-row">
            <div class="form-group">
              <label for="name">{form.nameLabel || 'Nome'}</label>
              <input type="text" id="name" name="name" placeholder={form.namePlaceholder || 'Seu nome'} required />
            </div>
            <div class="form-group">
              <label for="email">{form.emailLabel || 'E-mail'}</label>
              <input type="email" id="email" name="email" placeholder={form.emailPlaceholder || 'seu@email.com'} required />
            </div>
          </div>

          <div class="form-group">
            <label for="subject">{form.subjectLabel || 'Objetivo'}</label>
            <select id="subject" name="subject" required>
              <option value="" disabled selected>{form.subjectPlaceholder || 'Selecione uma necessidade'}</option>
              {subjects.map((s: any) => <option value={s.value}>{s.label}</option>)}
            </select>
          </div>

          <div class="form-group">
            <label for="message">{form.messageLabel || 'Mensagem'}</label>
            <textarea id="message" name="message" rows="6" placeholder={form.messagePlaceholder || 'Conte sobre seu projeto...'} required></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-full">{form.submitText || 'Enviar solicitação'}</button>
        </form>
      </div>

      <aside class="contact-faq">
        <span class="section-label">FAQ</span>
        <h2>{faqSec.title || 'Dúvidas frequentes'}</h2>
        <div class="faq-list">
          {faqs.map((faq: any) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding: calc(var(--navbar-height) + var(--space-4xl)) 0 var(--space-4xl);
    background:
      linear-gradient(135deg, rgba(52, 8, 88, 0.94), rgba(142, 36, 204, 0.82)),
      linear-gradient(90deg, rgba(20, 8, 36, 0.88), rgba(115, 63, 208, 0.52)),
      url('/images/marketing-agency-hero.jpg') center/cover;
  }

  .contact-hero-inner,
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 0.78fr;
    gap: var(--space-4xl);
    align-items: start;
  }

  .contact-hero .section-label {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.18);
    color: var(--color-accent-light);
  }

  .contact-hero h1 {
    color: #fff;
    font-size: var(--fs-hero);
    line-height: 1.04;
    letter-spacing: 0;
  }

  .contact-hero h1 span {
    display: block;
    color: var(--color-accent-light);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: var(--fw-regular);
  }

  .contact-hero p {
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--fs-lg);
    line-height: var(--lh-relaxed);
  }

  .contact-methods {
    background: var(--color-bg-dark);
  }

  .methods-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  .methods-grid article {
    background: var(--color-bg-dark);
    padding: var(--space-2xl);
    color: #fff;
  }

  .method-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-accent-light);
    margin-bottom: var(--space-lg);
  }

  .methods-grid h3 {
    color: #fff;
    font-size: var(--fs-lg);
    letter-spacing: 0;
    margin-bottom: var(--space-xs);
  }

  .methods-grid strong {
    display: block;
    color: var(--color-accent-light);
    margin-bottom: var(--space-sm);
  }

  .methods-grid p {
    color: rgba(255, 255, 255, 0.68);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
  }

  .contact-main {
    background: var(--color-bg-warm);
  }

  .contact-form-panel,
  .contact-faq {
    background: var(--color-bg-pure);
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    padding: var(--space-2xl);
  }

  .contact-form-panel h2,
  .contact-faq h2 {
    font-size: var(--fs-3xl);
    letter-spacing: 0;
    margin-bottom: var(--space-md);
  }

  .contact-form-panel > p {
    color: var(--color-text-muted);
    line-height: var(--lh-relaxed);
    margin-bottom: var(--space-2xl);
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .form-group {
    margin-bottom: var(--space-lg);
  }

  .form-group label {
    display: block;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--ls-wider);
    margin-bottom: var(--space-sm);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    outline: none;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 150px;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(27, 67, 50, 0.08);
  }

  .btn-full {
    width: 100%;
  }

  .faq-list {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .faq-list details {
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    padding: var(--space-lg);
    background: var(--color-bg);
  }

  .faq-list summary {
    cursor: pointer;
    font-weight: var(--fw-bold);
  }

  .faq-list p {
    color: var(--color-text-muted);
    line-height: var(--lh-relaxed);
    margin-top: var(--space-md);
  }

  @media (max-width: 900px) {
    .contact-hero-inner,
    .contact-grid,
    .methods-grid,
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contactForm');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]');
    if (btn) {
      const successText = form.getAttribute('data-success-text') || 'Solicitação enviada!';
      btn.textContent = successText;
      btn.setAttribute('disabled', 'true');
      btn.style.opacity = '0.7';
    }
  });
</script>
