---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readData } from '../lib/readData';
import { socialLinkAttrs } from '../lib/socialLinks';

const data = readData('backlinks.json') || {};
const seo = data.seo || {};
const hero = data.hero || {};
const video = data.video || {};
const problem = data.problem || {};
const plans = data.plans || {};
const differentials = data.differentials || {};
const recommendation = data.recommendation || {};
const testimonials = data.testimonials || {};
const testimonialItems = testimonials.items || [];
const testimonialGroups = [];
for (let i = 0; i < testimonialItems.length; i += 3) {
  testimonialGroups.push(testimonialItems.slice(i, i + 3));
}
const testimonialMobileGroups = testimonialItems.map((item: any) => [item]);
const support = data.support || {};
const team = data.team || {};
const niches = data.niches || {};
const faq = data.faq || {};
const cta = data.cta || {};
const planItems = plans.items || [];
const faqItems = faq.items || [];
const heroVisual = hero.visual || {};
const heroVisualItems = heroVisual.items || [
  { number: '01', label: 'Conteúdo publicado' },
  { number: '02', label: 'Contexto do nicho' },
  { number: '03', label: 'Mais força no Google' },
];
const youtubeUrl = String(video.youtubeUrl || '').trim();
const getYouTubeVideoId = (url: string) => {
  if (!url) return '';
  try {
    const parsed = new URL(url);
    if (parsed.hostname.includes('youtu.be')) return parsed.pathname.replace('/', '').split('/')[0] || '';
    if (parsed.pathname.includes('/shorts/')) return parsed.pathname.split('/shorts/')[1]?.split('/')[0] || '';
    if (parsed.pathname.includes('/embed/')) return parsed.pathname.split('/embed/')[1]?.split('/')[0] || '';
    return parsed.searchParams.get('v') || '';
  } catch {
    return '';
  }
};
const youtubeVideoId = getYouTubeVideoId(youtubeUrl);
---

<BaseLayout
  title={seo.title || 'Comprar Backlinks'}
  description={seo.description || 'Backlinks orgânicos de sites reais e confiáveis.'}
  image={seo.image || undefined}
>
