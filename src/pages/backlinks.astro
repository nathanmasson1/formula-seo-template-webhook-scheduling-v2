  <script is:inline>
    (() => {
      const stats = document.querySelector('[data-countup-stats]');
      if (!stats) return;
      const numbers = Array.from(stats.querySelectorAll('[data-countup-value]'));
      if (!numbers.length) return;

      const parseNumber = (value) => {
        const match = String(value).match(/^(\D*)([\d.,]+)(.*)$/);
        if (!match) return null;
        const rawNumber = match[2].replace(/\./g, '').replace(',', '.');
        const target = Number(rawNumber);
        if (!Number.isFinite(target)) return null;
        return { prefix: match[1], target, suffix: match[3] };
      };

      const formatValue = ({ prefix, target, suffix }, progress) => {
        const value = Math.round(target * progress);
        return `${prefix}${value.toLocaleString('pt-BR')}${suffix}`;
      };

      const animate = () => {
        const duration = 1400;
        const start = performance.now();
        const parsed = numbers.map((el) => ({ el, data: parseNumber(el.getAttribute('data-countup-value') || el.textContent || '') }));

        const tick = (now) => {
          const linear = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - linear, 3);
          parsed.forEach(({ el, data }) => {
            if (data) el.textContent = formatValue(data, eased);
          });
          if (linear < 1) requestAnimationFrame(tick);
        };

        requestAnimationFrame(tick);
      };

      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        animate();
      }, { threshold: 0.35 });

      observer.observe(stats);
    })();
  </script>

