---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import HeadPlugins from '../plugins/_slots/HeadPlugins.astro';
import BodyEndPlugins from '../plugins/_slots/BodyEndPlugins.astro';
import { readData } from '../lib/readData';
import { buildCanonicalUrl, buildSiteUrl, getConfiguredSiteUrl } from '../lib/siteUrl';

interface Product {
  name: string;
  price?: string;
  affiliateLink: string;
  rating?: number;
  image?: string;
}

interface Breadcrumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  rating?: number;
  products?: Product[];
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  description,
  image = '/images/og-default.jpg',
  canonicalURL,
  type = 'website',
  pubDate,
  updatedDate,
  author = 'SeuBlog',
  rating,
  products = [],
  breadcrumbs = [],
} = Astro.props;

const site = readData('siteConfig.json') || {};
const pluginsConfig = readData('pluginsConfig.json') || {};
const seoConfig = pluginsConfig?.seo || {};
const siteName = site.name || 'Seu Blog';
const siteUrl = getConfiguredSiteUrl(Astro.site);
const pageUrl = buildCanonicalUrl(canonicalURL || Astro.url.pathname, siteUrl);
const imageUrl = buildSiteUrl(image, siteUrl);
const orgName = seoConfig.orgName || siteName;
const orgLogo = seoConfig.orgLogo || site.logo || '';
const sameAs = Array.isArray(seoConfig.sameAs) ? seoConfig.sameAs.filter(Boolean) : [];
const isHomePage = Astro.url.pathname === '/';
const fullTitle = isHomePage ? siteName : `${title} | ${siteName}`;
const favicon = site.favicon || '/favicon.svg';
const seoToolkitEnabled = seoConfig.enabled !== false;
const articleSchemaEnabled = seoToolkitEnabled && seoConfig.articleSchema !== false;
const breadcrumbSchemaEnabled = seoToolkitEnabled && seoConfig.breadcrumbSchema !== false;
const websiteSchemaEnabled = seoToolkitEnabled && seoConfig.websiteSchema !== false;

// Build JSON-LD
const mainSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'BlogPosting' : 'WebSite',
  name: fullTitle,
  headline: title,
  description,
  url: pageUrl,
  publisher: {
    '@type': 'Organization',
    name: orgName,
    url: siteUrl,
    ...(orgLogo ? { logo: { '@type': 'ImageObject', url: new URL(orgLogo, siteUrl).toString() } } : {}),
  },
};

if (type === 'article') {
  if (pubDate) mainSchema.datePublished = pubDate.toISOString();
  if (updatedDate) mainSchema.dateModified = updatedDate.toISOString();
  if (image) mainSchema.image = imageUrl;
  mainSchema.author = { '@type': 'Person', name: author };
  mainSchema.mainEntityOfPage = { '@type': 'WebPage', '@id': pageUrl };

  if (rating) {
    mainSchema.review = {
      '@type': 'Review',
      reviewRating: {
        '@type': 'Rating',
        ratingValue: rating,
        bestRating: 10,
      },
      author: { '@type': 'Person', name: author },
    };
  }
}

// Product schemas
const productSchemas = products.filter(p => p.name).map((p) => {
  const schema: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    ...(p.image ? { image: buildSiteUrl(p.image, siteUrl) } : {}),
    ...(p.rating ? {
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: p.rating,
        bestRating: 5,
        ratingCount: 1,
      },
    } : {}),
    offers: {
      '@type': 'Offer',
      url: p.affiliateLink,
      priceCurrency: 'BRL',
      availability: 'https://schema.org/InStock',
      ...(p.price ? { price: p.price.replace(/[^\d,.]/g, '').replace(',', '.') } : {}),
    },
  };
  return schema;
});

// Breadcrumb schema
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.name,
    item: buildSiteUrl(crumb.url, siteUrl),
  })),
} : null;

const websiteSchema = websiteSchemaEnabled ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteUrl,
  publisher: {
    '@type': 'Organization',
    name: orgName,
    ...(orgLogo ? { logo: { '@type': 'ImageObject', url: new URL(orgLogo, siteUrl).toString() } } : {}),
  },
  ...(sameAs.length > 0 ? { sameAs } : {}),
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl.replace(/\/$/, '')}/blog?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
} : null;

const shouldRenderMainSchema =
  seoToolkitEnabled &&
  type === 'article' &&
  articleSchemaEnabled;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {author && <meta name="author" content={author} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="pt_BR" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Fonts — Instrument Serif (display) + Outfit (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={buildSiteUrl('/rss.xml', siteUrl)}
    />

    <!-- JSON-LD: Main Schema -->
    {shouldRenderMainSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(mainSchema)} />
    )}

    <!-- JSON-LD: Breadcrumbs -->
    {breadcrumbSchemaEnabled && breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- JSON-LD: WebSite -->
    {websiteSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}

    <!-- JSON-LD: Products -->
    {seoToolkitEnabled && productSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <HeadPlugins />
  </head>
  <body class="grain">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.animate-on-scroll, .stagger-children').forEach((el) => {
        observer.observe(el);
      });
    </script>
    <BodyEndPlugins />
  </body>
</html>
